LOW_STOCK_THRESHOLD=10

# OPTIONAL / STRETCH ONLY: intentionally NONWORKING placeholder.
# Do not replace it with a real Anthropic API key for Week 6.
# No Anthropic signup, payment, or live API call is needed.
ANTHROPIC_API_KEY=YOUR_PLACEHOLDER_KEY_HERE
